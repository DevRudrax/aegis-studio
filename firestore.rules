rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requester is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the requester is the resource owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Strict Tenant Isolation: User-scoped journals and audit streams
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Journal logs generated by Aegis AI orchestration
      match /journals/{journalId} {
        allow read, write: if isOwner(userId);
      }
      
      // Real-time telemetry events
      match /telemetry_events/{eventId} {
        allow read, write: if isOwner(userId);
      }
      
      // Workspace metadata & configuration
      match /workspace_metadata/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Deep nested subcollections under user scope
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other root access by default for zero-trust posture
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
